# Backend environment variables (no secrets)
PORT=4000
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mastermytrack
# JWT secrets for access/refresh tokens
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
# Frontend URLs for redirect + CORS (comma-separated list)
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173
# Redis connection for BullMQ
REDIS_URL=redis://localhost:6379
# Stripe keys (use test keys locally)
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
# Local storage path for uploads/masters
UPLOADS_DIR=uploads
